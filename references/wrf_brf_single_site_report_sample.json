{
  "source": "WWF Biodiversity Risk Filter - Single Site Analysis",
  "url": "https://riskfilter.org/biodiversity/analyse/single-site-details",
  "description": "BRF 单点位分析的真实输出格式。包含62个指标，按Physical Risk / Regulatory Deficiency Risk / Reputational Risk 三类组织，评分1-5（5最严重），-333表示不适用于该行业，-999表示数据不可用。",
  "score_legend": {
    "1": "Very Low Risk（几乎无风险）",
    "2": "Low Risk（低风险）",
    "3": "Medium Risk（中等风险）",
    "4": "High Risk（高风险）",
    "5": "Very High Risk（极高风险）",
    "-333": "Not Applicable（该指标对该经济活动不适用）",
    "-999": "Data Not Available（数据不可用/无法评估）"
  },

