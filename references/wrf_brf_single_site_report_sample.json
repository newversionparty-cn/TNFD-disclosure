      "Latitude & Longitude（经纬度）",
      "Optional: Sensitivity Scores（1-5，内部自评）"
    ],
    "output_structure": "hierarchical JSON with 62 indicators across 3 risk categories",
    "integration_with_leap": {
      "L": "BRF takes lat/lng to scope the spatial context",
      "E": "BRF uses industry (ISIC) to filter applicable indicators and weights",
      "A": "BRF scores across 62 indicators form the basis of financial risk quantification",
      "P": "BRF output feeds into TNFD materiality assessment"
    },
    "sensitivity_layer": "BRF scores can be modified by Sensitivity (1-5) layer: Final Risk = BRF Score × Sensitivity Multiplier"
